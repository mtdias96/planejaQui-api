# Environment (development | production | test)
NODE_ENV=development

# Database connection URL (Neon or PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Authentication configuration (JWT + Refresh Tokens)
JWT_SECRET=super_secret_key_at_least_32_characters_long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_GRACE_PERIOD_SECONDS=10

# Allowed origins for CORS configuration (comma-separated if multiple origins)
CORS_ALLOWED_ORIGINS=https://planejaqui.vercel.app

# Pluggy (Open Finance) credentials — https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=your_pluggy_client_id
PLUGGY_CLIENT_SECRET=your_pluggy_client_secret

# Pluggy API base URL (override only to point at a mock server)
PLUGGY_BASE_URL=https://api.pluggy.ai

# Public HTTPS URL of POST /pluggy/webhook. Pluggy rejects localhost — use the
# deployed API Gateway URL, or an ngrok tunnel for local testing.
PLUGGY_WEBHOOK_URL=https://your-api-id.execute-api.sa-east-1.amazonaws.com/pluggy/webhook

# Shared secret sent by Pluggy as the "X-Webhook-Secret" custom header.
# Generate with: openssl rand -hex 32
# Required outside development — the webhook rejects every request without it.
PLUGGY_WEBHOOK_SECRET=your_webhook_shared_secret
